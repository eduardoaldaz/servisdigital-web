# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://servisdigital.com

# Agenda para reuniones (Cal.com o Calendly). Si está vacío, /contacto muestra solo el formulario.
NEXT_PUBLIC_BOOKING_URL=

# WhatsApp por país, solo dígitos con prefijo internacional (vacío = no se muestra)
NEXT_PUBLIC_WHATSAPP_EC=593968851389
NEXT_PUBLIC_WHATSAPP_ES=

# Formulario de contacto: SMTP y destinatario. Sin SMTP_URL, las solicitudes solo se registran en el log del servidor.
SMTP_URL=
CONTACT_TO=hola@servisdigital.com
CONTACT_FROM="Servis Digital <no-reply@servisdigital.com>"
